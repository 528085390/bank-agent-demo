# 可选。数据库默认从仓库根目录的 database.txt 读取（该文件不入库，请复制
# database.txt.example 为 database.txt 并填写本机连接信息，连 test 库），
# 所以按模板创建后不配这个文件也能跑。只有要覆盖 SMTP / Redis / DEMO_MODE，
# 或指向别的数据库时才需要它。
# 复制为 backend/.env。注意 pydantic 读的是相对工作目录的 `.env`，而应用从 backend/
# 启动，所以配置必须放 backend/ 下；仓库根目录的 .env 不会被读取。
#
# 两个文件，后加载的覆盖前面的：`.env`（本机配置，不入库）→ `.env.local`（同样不入库，
# 放每台机器一份的密钥）。两者都被 `.gitignore` 挡住；只有本模板会进仓库。
# 所以密钥写哪一个都不会被提交，但 `.env` 更偏「这台机器怎么跑」、`.env.local` 更偏「这台
# 机器的凭证」，按这个分工写最不容易搞混。

# 默认值示例（不需要照抄，改这一行才会覆盖默认）：
# DATABASE_URL=postgresql+psycopg://root01:<database.txt 里的密码>@<外网地址>:5432/test
# 不要指向 bank_db：那是子项目 bank_backend 的主库，跑的是他们自己的 Alembic 链。

DEMO_MODE=true
COOKIE_SECURE=false

# 账号。ALLOW_DEMO_LOGIN=false 时 `POST /api/session` 一律 403，只能走 /api/auth/login；
# 单用户演示机想保留「一键进入」才改成 true。
ALLOW_DEMO_LOGIN=false
# 空闲 30 分钟、绝对 24 小时（SESSION_HOURS）；失败 5 次锁 15 分钟。
AUTH_SESSION_IDLE_MINUTES=30
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_LOCK_MINUTES=15
# 注册领取的客户池大小，必须与 bank_backend 的 seed_customer_pool --count 一致。
BANK_POOL_SIZE=20

# 服务间凭证：app 调 bank_backend 时带的 X-Service-Token，必须与
# bank_backend/.env 的 SERVICE_TOKEN 完全相同。留空时 bank 会拒绝所有调用（401），
# 每个银行工具都失败——这是有意的「宁可用不了也不裸奔」。
# 本机不需要手填：start.ps1 首启时生成一次并写进本文件；这里留空是因为它是每台机器
# 各一份的密钥，不能提交。
BANK_SERVICE_TOKEN=

# 模型（可选，但填了就省去每次启动进设置面板）。三项齐全时进程启动即已配置好模型；
# 留空 LLM_API_KEY 则维持原行为：启动时未配置，聊天返回 MODEL_NOT_CONFIGURED。
# LLM_API_KEY 是密钥：写进 backend/.env.local（被 git 忽略），不要写进本模板 ——
# 模板会进仓库，等于把 key 直接推到远端。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_RESPONSE_FORMAT=json_schema
LLM_TIMEOUT_SECONDS=30

# 邮件。SMTP_* 留空时邮件功能不可用；EMAIL_QUEUE_ENABLED=false 时同步发送。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_FROM_NAME=银行AI智能体
EMAIL_QUEUE_ENABLED=false
EMAIL_QUEUE_REDIS_URL=redis://127.0.0.1:6379/1
EMAIL_QUEUE_NAME=email_queue
EMAIL_QUEUE_DLQ=email_dlq
EMAIL_QUEUE_RETRY_QUEUE=email_retry_queue
EMAIL_QUEUE_MAX_RETRIES=3
EMAIL_QUEUE_RETRY_DELAYS=[60,300,900]
EMAIL_QUEUE_POLL_TIMEOUT=5

# 当前交付版包含 Supervisor 意图路由、展示层任务 DAG、绿黄红判级、
# 确认卡 / MFA / 人工接管、操作审计与幂等恢复；没有单独的 planner mode。
# 模型是唯一的自然语言决策者：Supervisor 图路由到六个领域 Agent，
# 在设置面板里配置 Chat Completions 模型。未配置时聊天返回 MODEL_NOT_CONFIGURED，
# 而不是回退到规则脚本。
