  "cards": [
    {
      "dot": "cyan",
      "title": "主链路事实",
      "items": [
        "thread_id 由 session_id 派生，客户端从不发送 thread id",
        "进程内 per-session 锁串行同一会话；首期单 worker",
        "图按调用构建，领域子图绑定调用者的 Handle",
        "模型调用次数由结构决定：闲聊 1 次，业务委派 3 次"
      ]
    },
    {
      "dot": "rose",
      "title": "信任边界",
      "items": [
        "bank_session cookie 与 body.session_id 不一致即 401",
        "模型输出不可信：请求里的 agent 字段被完全忽略",
        "身份在构造 Handle 时固定，模型无法构造 Handle",
        "bank_customer_id 解析失败降级为 None，工具必须 fail closed"
      ]
    },
    {
      "dot": "amber",
      "title": "工具网关与外部依赖",
      "items": [
        "ToolCatalog 当前 0 个生产工具，每个 Handle 都为空",
        "幂等键在重试循环外铸一次并复用；call_id 每次新铸",
        "WRITE 工具无幂等键时在任何 HTTP 之前拒绝",
        "模型密钥仅存内存；SSE 6 个事件不持久化、不可重放"
      ]
    }
  ]
